---
import "@/styles/global.css";
import ViewTransitions from "astro/components/ViewTransitions.astro";

interface Props {
  title: string | undefined | null;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content='Astro description' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>

    <ViewTransitions />
  </head>
  <body class='mx-auto max-w-[1040px]'>
    <header>
      <nav class='flex justify-end py-5 px-10 gap-4'>
        <a class='underline underline-offset-4 hover:no-underline' href='/'>Sanity import</a>
        <a class='underline underline-offset-4 hover:no-underline' href='/tech-stack'>Tech stack</a>
      </nav>
    </header>
    <slot />
  </body>
</html>
