---
import Layout from "@/layouts/Layout.astro";
---

<Layout title='Novacare Fagdag'>
  <div class='w-full my-10 h-full gap-16 grid'>
    <h1 class='text-4xl font-bold'>Sanity dataimport</h1>

    <div class='flex flex-col justify-start gap-4 rounded'>
      <h2 class='text-2xl font-semibold ml-5'>Export</h2>
      <img class='rounded' src='/export.png' alt='' />
    </div>

    <div class='flex flex-col justify-start gap-4'>
      <h2 class='text-2xl font-semibold ml-3'>NDJSON</h2>
      <img src='/ndjson.png' alt='' />
    </div>

    <div class='flex flex-col justify-start gap-4'>
      <h2 class='text-2xl font-semibold'>Excel</h2>
      <img class='rounded-lg border-gray-400 border-1' src='/excel.png' alt='' />
    </div>
    <div class='flex flex-col justify-start gap-4'>
      <h2 class='text-2xl font-semibold'>ChatGPT</h2>
      <img class='rounded-lg border' src='/gpt.png' alt='' />
    </div>

    <div class='flex flex-col justify-start gap-4'>
      <h2 class='text-2xl font-semibold ml-6'>Import</h2>
      <img src='/import.png' alt='' />
    </div>
  </div>
</Layout>
